# =====================================================
# Sura - Konfigurasi monorepo (root .env)
# =====================================================
# Disalin oleh API saat dijalankan dengan bun (auto-load .env).

# Database
DATABASE_URL=postgresql://sura_user:your_secure_password@localhost:5432/sura_db

# Aplikasi
NODE_ENV=development
PORT=3000
JWT_SECRET=ganti_dengan_secret_random_anda
JWT_EXPIRES_IN=7d

# CORS - tambahkan origin web & mobile (Expo dev tools) dipisah koma
CORS_ORIGIN=http://localhost:5173,http://localhost:19006,http://localhost:8081
